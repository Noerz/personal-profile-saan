# ─────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
APP_NAME="Personal Profile API"

# ─────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────
DATABASE_URL="mysql://root:password@localhost:3306/personal_profile"

# ─────────────────────────────────────────
# JWT
# ─────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────
# CORS
# ─────────────────────────────────────────
# Comma-separated list of allowed origins
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# Auth endpoints (more strict)
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=5

# ─────────────────────────────────────────
# FILE UPLOAD
# ─────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_IMAGE=5242880
# 5MB in bytes
MAX_FILE_SIZE_DOCUMENT=10485760
# 10MB in bytes

# ─────────────────────────────────────────
# SEED (Super Admin)
# ─────────────────────────────────────────
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_EMAIL=superadmin@example.com
SEED_ADMIN_PASSWORD=SuperAdmin@123!

# ─────────────────────────────────────────
# EMAIL (Optional - for Forgot Password)
# ─────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM="Personal Profile <noreply@example.com>"

# Set to "true" to return reset token in response (development only)
MAIL_DEV_MODE=true
